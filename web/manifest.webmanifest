{
  "id": "./",
  "name": "Bavin Web — packet analyzer",
  "short_name": "Bavin",
  "description": "Read network captures layer by layer, from Ethernet up to HTTP. Runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e131a",
  "theme_color": "#1b2a4a",
  "categories": ["education", "developer", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.tcpdump.pcap": [".pcap", ".cap"],
        "application/octet-stream": [".pcapng"]
      }
    }
  ]
}
